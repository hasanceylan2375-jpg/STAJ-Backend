{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "STAJ",
    "Audience": "STAJFrontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Security": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 60,
    "UserPermitLimit": 30,
    "LoginPermitLimit": 5,
    "AuthPermitLimit": 10,
    "ReadPermitLimit": 40,
    "WritePermitLimit": 15
  },
  "Quota": {
    "DailyLimit": 10000,
    "MonthlyLimit": 100000
  },
  "Performance": {
    "MaxConcurrentRequests": 50,
    "BulkheadPerUserConcurrency": 5,
    "BackpressureWaitMilliseconds": 2000,
    "MaxRequestBodyBytes": 10485760,
    "MaxManagedMemoryBytes": 536870912,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerBreakSeconds": 30
  },
  "BackgroundJobs": {
    "DailyLogMaintenanceCron": "0 3 * * *",
    "DatabaseHealthCheckCron": "*/30 * * * *",
    "BirthdayEmailCron": "0 9 * * *",
    "AuditRetentionDays": 30
  }
}
